{
  "name": "marmara-shop-backend",
  "version": "1.0.0",
  "description": "MarmaraShop - MedusaJS backend with MongoDB integration",
  "private": true,
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build",
    "start": "medusa start",
    "seed": "node --require ts-node/register src/scripts/seed.ts",
    "migrate": "medusa migrations run",
    "migrations:generate": "medusa migrations generate",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.6.0",
    "bull": "^4.11.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.11.0",
    "mongoose": "^7.5.3",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "ts-node": "^10.9.0",
    "eslint": "^8.49.0",
    "prettier": "^3.0.0",
    "jest": "^29.7.0",
    "@types/bcryptjs": "^2.4.0",
    "ts-jest": "^29.1.0"
  },
  "medusa": {
    "plugins": []
  }
}
