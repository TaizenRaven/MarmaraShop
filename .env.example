# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/marmara_shop?retryWrites=true&w=majority
MONGODB_DB_NAME=marmara_shop

# ============================================
# MEDUSA JS BACKEND
# ============================================
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_URL=http://localhost:7001
MEDUSA_REDIS_URL=redis://localhost:6379
MEDUSA_JWT_SECRET=your_jwt_secret_key_here_min_32_chars
MEDUSA_COOKIE_SECRET=your_cookie_secret_key_here

# ============================================
# NEXT.JS FRONTEND
# ============================================
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# NEXT.JS ADMIN PANEL
# ============================================
NEXT_PUBLIC_ADMIN_URL=http://localhost:7001
NEXT_PUBLIC_BACKEND_URL=http://localhost:9000
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_min_32_chars

# ============================================
# OZONEXPRESS SHIPPING API
# ============================================
OZONEXPRESS_API_KEY=your_ozonexpress_api_key
OZONEXPRESS_API_SECRET=your_ozonexpress_api_secret
OZONEXPRESS_API_URL=https://api.ozonexpress.kg/api/v1
OZONEXPRESS_ACCOUNT_ID=your_account_id

# ============================================
# WEBHOOKS & NOTIFICATIONS
# ============================================
WEBHOOK_SECRET=your_webhook_secret_key
NOTIFICATION_EMAIL_SERVICE=sendgrid
NOTIFICATION_SMS_SERVICE=twilio
SENDGRID_API_KEY=your_sendgrid_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# ADMIN SETTINGS
# ============================================
ADMIN_EMAIL=admin@marmara.shop
ADMIN_DEFAULT_PASSWORD=change_me_in_production

# ============================================
# SEO & ANALYTICS (Optional)
# ============================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G_XXXXXXXXXX
NEXT_PUBLIC_SITE_URL=https://www.marmara.shop
